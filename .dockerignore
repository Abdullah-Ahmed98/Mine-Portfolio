# Kept out of the image on purpose. Anything listed here is either rebuilt
# inside the container, machine-specific, or must never reach a registry.

# Secrets. The host injects these as environment variables at runtime, and a
# leaked .env in a published image is a leaked production credential.
.env
.env.*
!.env.example

# Rebuilt inside the container from package-lock.json.
node_modules

# Installed inside the container by composer install --no-dev.
vendor

# Copied in from the Vite build stage, so a stale local copy must not win.
/public/build
/public/hot

# Machine-specific. This one matters most: it is a SQLite database holding the
# admin user and its password hash, and the live database is Neon.
/database/*.sqlite
/database/*.sqlite-*

# Local runtime state that must never travel.
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# Version control and CI.
.git
.gitignore
.github

# Local tooling and documentation that is not part of the running site.
.deploy-staging
/tests
/.ai
/portfolio.html
/README.md
/phpunit.xml
/phpunit.xml.dist
